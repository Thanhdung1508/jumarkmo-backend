# Thiết lập Environment variables trong IntelliJ Run Configuration (không tự đọc file này).
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/juniormark?stringtype=unspecified
DATABASE_USER=postgres
